# ═══════════════════════════════════════════════════════════════════════════════
# SalesNet Backend — .env.example
# Copiar para .env e preencher os valores reais
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM / IA ───────────────────────────────────────────────────────────────────
# Modo de roteamento: single (1 provider) ou tiered (rota por complexidade)
LLM_ROUTING_MODE=tiered
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=deepseek

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=AIza...   # https://aistudio.google.com/app/apikey

# Groq — transcrição de áudio via Whisper (opcional; sem esta chave áudio é ignorado)
# Obter em: https://console.groq.com
GROQ_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_MAX_TOKENS=1024
LLM_SIMPLE_MAX_TOKENS=512
LLM_SIMPLE_MAX_TOOL_ROUNDS=3
LLM_DAILY_BUDGET_USD=10

# ── Observability ──────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── WhatsApp Provider ──────────────────────────────────────────────────────────
# Provider ativo: evolution-go (padrão) | twilio (legado)
WHATSAPP_PROVIDER=evolution-go

# Evolution Go — provider principal
# Em Railway: URL do serviço Evolution no Private Networking
# Em VPS: http://evolution:8080 (nome do container Docker)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=sua_chave_api_evolution_aqui

# Nome da instância no Evolution Go (deve ser único por instalação)
# Número de produção: +55 85 8475-1101 (escanear QR com este telefone)
EVOLUTION_INSTANCE_NAME=salesnet

# Token por-instância (gerado na criação da instância) — usado para enviar mensagens
EVOLUTION_INSTANCE_TOKEN=

# Segredo HMAC-SHA256 do webhook (opcional; se omitido, aceita webhooks sem validar)
# Deve ser IGUAL ao "Webhook Secret" configurado na instância Evolution (painel da instância).
# Após alterar, reconecte a instância no Evolution para reenviar o secret no connect.
# Pode ser o mesmo valor de EVOLUTION_INSTANCE_TOKEN se você padronizar assim.
EVOLUTION_WEBHOOK_SECRET=

# EVOLUTION_WEBHOOK_SKIP_HMAC=true
# Desabilita toda validação de webhook — usar APENAS em emergência

# ── Twilio — LEGADO (remover após migração completa) ──────────────────────────
# Manter apenas se ainda houver mensagens em trânsito pelo Twilio.
# Quando remover: apagar estas 3 linhas e remover o pacote "twilio" do package.json.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# ── Tenant ─────────────────────────────────────────────────────────────────────
# Modo: single (1 empresa) | multi (futuro multi-tenant)
TENANT_MODE=single
DEFAULT_TENANT_ID=salesnet-default

# URL pública do backend (usada para montar webhook URLs das instâncias)
# Railway: https://seu-backend.railway.app
# VPS: https://api.seudominio.com.br
BACKEND_URL=https://seu-backend.railway.app

# Número WhatsApp (só dígitos, com DDI/DDD) que recebe alertas operacionais da Sofia
# Detecção de padrões (cluster de quedas, spike de cobrança, onda de churn, etc.)
ADMIN_ALERT_PHONE=5585996032957

# Número sandbox dedicado para testes ao vivo (webhook simulado, processMessage direto,
# scripts de diagnóstico). NUNCA um número pessoal ou de cliente real — ver
# assertSandboxNumber em src/utils/test-sandbox.ts e "Política de testes ao vivo" no CLAUDE.md.
TEST_SANDBOX_PHONE=

# ── ERP SGP ────────────────────────────────────────────────────────────────────
SGP_BASE_URL=https://sgp.seuisp.com.br/api
SGP_API_TOKEN=
# Nome do app exatamente como cadastrado no painel SGP (obrigatório)
SGP_APP_NAME=Ronald

# Segredo HMAC-SHA256 para webhook de confirmação de pagamento (POST /webhook/sgp/payment-confirmed)
# Configure o mesmo valor no SGP ao registrar a URL do webhook; header: x-sgp-signature
# Gerar: openssl rand -hex 32
SGP_WEBHOOK_SECRET=

# ── Supabase (banco de dados / storage) ───────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# URL do frontend — obrigatório em produção (CORS). Ex.: https://salesnet-green.vercel.app
CORS_ORIGIN=https://salesnet-green.vercel.app

# ── Docker Compose (não incluir no Railway) ────────────────────────────────────
DB_PASSWORD=senha_postgres_segura_aqui
EVOLUTION_SERVER_URL=https://evolution.seudominio.com.br
