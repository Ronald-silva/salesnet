# ═══════════════════════════════════════════════════════════════════════════════
# SalesNet Backend — .env.example
# Copiar para .env e preencher os valores reais
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM / IA ───────────────────────────────────────────────────────────────────
# Modo de roteamento: single (1 provider) ou tiered (rota por complexidade)
LLM_ROUTING_MODE=tiered
LLM_PROVIDER=anthropic
LLM_FALLBACK_PROVIDER=deepseek

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_MAX_TOKENS=1024
LLM_SIMPLE_MAX_TOKENS=512
LLM_SIMPLE_MAX_TOOL_ROUNDS=3

# ── WhatsApp Provider ──────────────────────────────────────────────────────────
# Provider ativo: evolution-go (padrão) | twilio (legado)
WHATSAPP_PROVIDER=evolution-go

# Evolution Go — provider principal
# Em Railway: URL do serviço Evolution no Private Networking
# Em VPS: http://evolution:8080 (nome do container Docker)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=sua_chave_api_evolution_aqui

# Nome da instância no Evolution Go (deve ser único por instalação)
# Número de produção: +55 85 8475-1101 (escanear QR com este telefone)
EVOLUTION_INSTANCE_NAME=salesnet

# ── Twilio — LEGADO (remover após migração completa) ──────────────────────────
# Manter apenas se ainda houver mensagens em trânsito pelo Twilio.
# Quando remover: apagar estas 3 linhas e remover o pacote "twilio" do package.json.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# ── Tenant ─────────────────────────────────────────────────────────────────────
# Modo: single (1 empresa) | multi (futuro multi-tenant)
TENANT_MODE=single
DEFAULT_TENANT_ID=salesnet-default

# URL pública do backend (usada para montar webhook URLs das instâncias)
# Railway: https://seu-backend.railway.app
# VPS: https://api.seudominio.com.br
BACKEND_URL=https://seu-backend.railway.app

# ── ERP SGP ────────────────────────────────────────────────────────────────────
SGP_BASE_URL=https://sgp.seuisp.com.br/api
SGP_API_TOKEN=

# ── Supabase (banco de dados / storage) ───────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Docker Compose (não incluir no Railway) ────────────────────────────────────
DB_PASSWORD=senha_postgres_segura_aqui
EVOLUTION_SERVER_URL=https://evolution.seudominio.com.br
